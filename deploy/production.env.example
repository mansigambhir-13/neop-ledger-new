# Inputs for scripts/deploy.sh. Copy to a private path (NOT the repo), fill in, keep 0600.
# Nothing secret goes in this file: secrets are FILES the script reads once into NEOS_SECRETS_DIR.

NEOS_PROJECT=neops                              # docker compose project name
NEOS_SECRETS_DIR=/srv/neops/secrets             # generated secrets live here (0700); back it up
NEOS_PLATFORM_PORT=4000                         # platform API on 127.0.0.1:<port> (put TLS in front to expose it)

COMPANY_NAME="Acme Traders"
COMPANY_TZ=Asia/Kolkata
ADMIN_NAME="Priya"
ADMIN_EMAIL=priya@acme.in
STARTER_CHART=in_sme                            # the Indian SME chart of accounts on a first install (none = start empty)
ADMIN_MXID=@priya:matrix.example.com            # optional: the admin's own Matrix id (a person may approve in her own DM)

# The model, through the LLM proxy (the assistant never holds this key)
NEOP_LLM_UPSTREAM_URL=https://openrouter.ai/api  # or https://api.anthropic.com
NEOP_LLM_UPSTREAM_AUTH=bearer                   # x-api-key for Anthropic
NEOP_LLM_UPSTREAM_MODEL_PREFIX=anthropic/       # empty for Anthropic
LLM_KEY_FILE=/srv/neops/inputs/llm_upstream_key # a file holding the provider key (rotated for go-live)

# Matrix — the road the NEOS reasoning agent (NeuralChat, neos-agent-neuralchat #143) uses
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_SERVER_NAME=matrix.example.com
LEDGER_MXID=@ledger:matrix.example.com
LEDGER_MATRIX_TOKEN_FILE=/srv/neops/inputs/matrix_ledger_token   # operator-issued access token of @ledger
BRIDGE_MXID=@reasoning_agent:matrix.example.com # NeuralChat's account
# NeuralChat proposes and relays; it never approves. A person says yes on the desk or in their own DM (GO-LIVE §3).
MATRIX_REPLY_DEADLINE_MS=55000
# v3 S4 · who speaks for Ledger in Matrix. off (the default today): the platform's bridge, as rehearsed.
# client: the Ledger BACKEND itself runs @ledger's /sync road (deploy/compose.presence-client.yml) — jobs, answers and a
# person's yes go straight into Ledger's own schema; the platform then holds no Matrix token for Ledger. Switch only
# after the RUNBOOK's "Chat: NEOP presence" steps (and back the same way); NeuralChat sees no difference.
NEOP_PRESENCE=off

# Optional
OBSERVABILITY=0                                 # 1 = Jaeger/Prometheus/Grafana profile
# The email door's credential: written by deploy into the door secret store ($NEOS_SECRETS_DIR/doors/<company>/ledger/email.json,
# 0600, read by the Ledger backend per call). The key itself stays in its own file (api_key_file). Later changes:
# scripts/deploy.sh door set <company> email ledger < credential.json (see docs/RUNBOOK.md "Door secrets").
# JSON must be in SINGLE quotes (this file is read by bash), e.g.
# EMAIL_DOOR_JSON='{"provider":"resend","api_key_file":"/srv/neops/inputs/resend","from":"Acme Books <books@acme.in>"}'
EMAIL_DOOR_JSON=
