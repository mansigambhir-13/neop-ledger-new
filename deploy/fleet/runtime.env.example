# Non-secret inputs used by the generated per-app Compose contracts.
NEOP_VERSION=local
NEOP_BACKEND_CONTEXT=.
NEOP_AGENT_CONTEXT=.
NEOP_FRONTEND_CONTEXT=.
NEOP_FRONTEND_PORT=4105
NEOS_SECRETS_DIR=./secrets
NEOS_DB_NETWORK=neos-db
NEOS_FILES_NETWORK=neos-files
NEOS_LLM_NETWORK=neos-llm
NEOS_EDGE_NETWORK=neos-edge
NEOP_MATRIX_HOMESERVER_URL=https://matrix.example.com

# Credential values are not environment variables. Generated Compose reads only
# these per-app files beneath NEOS_SECRETS_DIR:
# app_db_url, runner_db_url, direct_db_url, job_token, llm_signing_key,
# matrix_accounts, frontend_key.
