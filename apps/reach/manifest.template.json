      "servedBy": "frontend",
      "process": "frontend",
      "path": "/apps/reach",
      "api": "/api/v1",
      "backend": "NEOS_PLATFORM_URL",
      "basePath": "NEOP_FRONTEND_BASE_PATH"
    },
    "processes": [
      {
        "name": "backend",
        "service": "reach-backend",
        "build": "../../../deploy/fleet/backend.Dockerfile",
        "command": "node entry.mjs",
        "port": 4101,
        "health": {
          "http": "http://127.0.0.1:4101/ready",
          "live": "http://127.0.0.1:4101/live"
        },
        "receives": [
          "platform-db",
          "operator",
          "platform-matrix"
        ],
        "credentials": [
          "NEOP_APP_DB_URL",
          "NEOP_RUNNER_DB_URL",
          "NEOP_DIRECT_DB_URL",
          "NEOP_JOB_TOKEN_SECRET",
          "NEOP_LLM_SIGNING_KEY",
          "NEOP_MATRIX_CLIENT_ACCOUNTS"
        ]
      },
      {
        "name": "agent",
        "service": "reach-agent",
        "build": "../../../deploy/fleet/agent.Dockerfile",
        "command": "node entry.mjs",
        "port": 4103,
        "health": {
          "http": "http://127.0.0.1:4103/live",
          "live": "http://127.0.0.1:4103/live"
        },
        "receives": [],
        "credentials": []
      },
      {
        "name": "frontend",
        "service": "reach-frontend",
        "build": "../../../deploy/fleet/frontend.Dockerfile",
        "command": "node entry.mjs",
        "port": 4105,
        "health": {
          "http": "http://127.0.0.1:4105/ready",
          "live": "http://127.0.0.1:4105/live"
        },
        "receives": [
          "operator"
        ],
        "credentials": [
          "NEOP_FRONTEND_KEY"
        ]
      }
    ],
    "credentials": [
      {
        "name": "NEOP_APP_DB_URL",
        "class": "platform-db",
        "process": "backend",
        "required": true,
        "secret": true,
        "purpose": "connection for reach_app, restricted to the reach schema"
      },
      {
        "name": "NEOP_RUNNER_DB_URL",
        "class": "platform-db",
        "process": "backend",
        "required": true,
        "secret": true,
        "purpose": "connection for reach_runner, used by the trusted backend only"
      },
      {
        "name": "NEOP_DIRECT_DB_URL",
        "class": "platform-db",
        "process": "backend",
        "required": true,
        "secret": true,
        "purpose": "direct database session for advisory locks and LISTEN"
