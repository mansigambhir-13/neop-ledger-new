  "packages": [],
  "files": true,
  "fileStore": {
    "route": "/api/v1/files",
    "store": "schema",
    "tables": [
      "files",
      "file_blobs"
    ],
    "key": "<schema>/<company>/<id>",
    "types": [
      "text/csv",
      "application/json",
      "application/pdf"
    ],
    "maxKb": 5120
  },
  "matrix": {
    "account": "NEOP_MATRIX_CLIENT_ACCOUNTS",
    "mode": "client",
    "direct_messages_only": true
  },
  "rooms": {
    "direct_messages": "1:1 with Reach's account, from users on the install allowlist"
  },
  "events": [
    "neos.neop.task",
    "neos.neop.ask",
    "neos.neop.answer",
    "neos.neop.propose",
    "neos.neop.approve",
    "neos.neop.done",
    "neos.neop.note"
  ],
  "valueClasses": {
    "money": "integer minor units + ISO currency",
    "unknown": "NULL",
    "personalData": [
      "audiences.source_id · audiences.name · audiences.category",
      "campaigns.source_id · campaigns.channel · campaigns.subject · campaigns.body · campaigns.source_snapshot",
      "draft_origins.draft_id · draft_origins.job_id · draft_origins.input_hash"
    ]
  },
  "scopes": [
    "reach.read",
    "reach.write"
  ],
  "keys": {
    "audiences": "id",
    "campaigns": "audience_id",
    "draft_origins": "proposer_user_id",
    "operations": "idempotency_key"
  },
  "tables": {
    "audiences": "(company_id, id); personal: source_id, name, category",
    "campaigns": "(company_id, audience_id); personal: source_id, channel, subject, body, source_snapshot",
    "draft_origins": "(company_id, proposer_user_id); personal: draft_id, job_id, input_hash",
    "standard": "jobs · steps · waits · proposals · grants · operations · facts · switchboard · installs · config · notices · schedules · files · file_blobs · source_status · demo_rows"
  },
  "sources": [],
  "switchboard": {
    "floor": {
