{
  "key": "nep-gst",
  "version": "2.0.0",
  "name": "GST filing (India)",
  "description": "Builds the monthly GSTR-3B from the host's books in the GSTN format, saves it on the GST portal through a GST Suvidha Provider, and files it with EVC only after a person's yes.",
  "doors": [
    "gst_portal",
    "gst_portal_otp"
  ],
  "requires": [
    "ledger.report.vat_summary",
    "ledger.report.pnl",
    "ledger.accounts.list",
    "ledger.account.ledger"
  ],
  "tables": [
    "nep_gst_returns"
  ],
  "abilities": [
    {
      "key": "gst.returns.list",
      "version": "2.0.0",
      "title": "GST returns",
      "kind": "read",
      "floor": "on",
      "description": "GSTR-3B returns this package has prepared, saved or filed, with their figures, how the tax was split, GSP status and portal acknowledgement (ARN).",
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generatedAt",
          "empty",
          "sources",
          "returns"
        ],
        "properties": {
          "generatedAt": {
            "type": "string"
          },
          "empty": {
            "type": "boolean"
          },
          "sources": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entries",
              "entry_ids",
              "basis"
            ],
            "properties": {
              "entries": {
                "type": "integer"
              },
              "entry_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis": {
                "type": "string"
              }
            }
          },
          "returns": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "period",
                "status",
                "output_tax_minor",
                "input_tax_minor",
                "net_payable_minor",
                "credit_carried_minor"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "period": {
                  "type": "string"
                },
                "ret_period": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "gstin": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "draft",
                    "saved",
                    "filed"
                  ]
                },
                "output_tax_minor": {
                  "type": "integer"
                },
                "input_tax_minor": {
                  "type": "integer"
                },
                "net_payable_minor": {
                  "type": "integer"
                },
                "credit_carried_minor": {
                  "type": "integer"
                },
                "split_basis": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "payload_sha256": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "gsp_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "gsp_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ack_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "key": "gst.gstr3b.prepare",
      "version": "2.0.0",
      "title": "Prepare the GSTR-3B from the books",
      "kind": "write",
      "floor": "on",
      "description": "Build the month's GSTR-3B (GSTN format) from the ledger: output tax, input tax credit and taxable value are read from the books, never typed in. Give only the month. Internal: nothing leaves the company. The result shows how CGST/SGST/IGST were split and what was assumed.",
      "input": {
        "type": "object",
        "required": [
          "period"
        ],
        "additionalProperties": false,
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "The month, YYYY-MM."
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "outcome"
        ]
      },
      "effects": {
        "external": false
      }
    },
    {
      "key": "gst.gstr3b.save",
      "version": "2.0.0",
      "title": "Save the GSTR-3B on the GST portal",
      "kind": "write",
      "floor": "on",
      "description": "Save the month's prepared GSTR-3B on the GST portal through the GSP (RETSAVE) and check its processing status. Saving is not filing: a saved return can be replaced. Needs a GST portal session; without one the portal sends an OTP to the registered mobile and a person enters it.",
      "input": {
        "type": "object",
        "required": [
          "period"
        ],
        "additionalProperties": false,
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "outcome"
        ]
      },
      "effects": {
        "external": true
      },
      "doors": [
        "gst_portal"
      ]
    },
    {
      "key": "gst.otp.request",
      "version": "2.0.0",
      "title": "Ask the GST portal for an OTP",
      "kind": "write",
      "floor": "on",
      "description": "Ask the GST portal to send an OTP by SMS: 'auth' to the registered mobile (to open a session), 'evc' to the authorised signatory (to sign a filing). A person enters the OTP on the GST portal OTP door; you never see or type it.",
      "input": {
        "type": "object",
        "required": [
          "purpose"
        ],
        "additionalProperties": false,
        "properties": {
          "purpose": {
            "type": "string",
            "enum": [
              "auth",
              "evc"
            ]
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "outcome"
        ]
      },
      "effects": {
        "external": true
      },
      "doors": [
        "gst_portal"
      ]
    },
    {
      "key": "gst.gstr3b.file",
      "version": "2.0.0",
      "title": "File the GSTR-3B",
      "kind": "write",
      "floor": "ask_first",
      "description": "File the month's saved GSTR-3B on the GST portal, signed with EVC. Binding. Give only the month: the proposal is bound to the saved return's figures and hash. The signatory's EVC OTP is entered by a person, never by you.",
      "input": {
        "type": "object",
        "required": [
          "period"
        ],
        "additionalProperties": false,
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "gstin": {
            "type": "string"
          },
          "ret_period": {
            "type": "string"
          },
          "return_id": {
            "type": "string"
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "output_tax_minor": {
            "type": "integer"
          },
          "input_tax_minor": {
            "type": "integer"
          },
          "net_payable_minor": {
            "type": "integer"
          },
          "credit_carried_minor": {
            "type": "integer"
          },
          "split_basis": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "required": [
          "outcome"
        ]
      },
      "effects": {
        "external": true
      },
      "doors": [
        "gst_portal"
      ]
    }
  ],
  "skills": [
    {
      "key": "gst-monthly-return",
      "requires": [
        "ledger.report.vat_summary",
        "ledger.report.pnl",
        "ledger.accounts.list",
        "ledger.account.ledger",
        "gst.gstr3b.prepare",
        "gst.gstr3b.save",
        "gst.otp.request",
        "gst.gstr3b.file",
        "gst.returns.list"
      ]
    }
  ],
  "migrations": [
    "001_returns.sql",
    "002_gstr3b.sql"
  ]
}
