    "neos.neop.propose",
    "neos.neop.approve",
    "neos.neop.done",
    "neos.neop.note"
  ],
  "valueClasses": {
    "money": "integer minor units + ISO currency",
    "unknown": "NULL",
    "personalData": [
      "vendors.name · vendors.category · vendors.source_id",
      "renewals.source_id · renewals.notes · renewals.source_snapshot",
      "draft_origins.draft_id · draft_origins.job_id · draft_origins.input_hash"
