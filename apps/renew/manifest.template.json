  "tables": {
    "vendors": "(company_id, id); personal: name, category, source_id",
    "renewals": "(company_id, vendor_id); personal: source_id, notes, source_snapshot",
    "draft_origins": "(company_id, proposer_user_id); personal: draft_id, job_id, input_hash",
    "standard": "jobs · steps · waits · proposals · grants · operations · facts · switchboard · installs · config · notices · schedules · files · file_blobs · source_status · demo_rows"
  },
  "sources": [],
  "switchboard": {
