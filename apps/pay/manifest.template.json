  "valueClasses": {
    "money": "integer minor units + ISO currency",
    "unknown": "NULL",
    "personalData": [
      "payees.name · payees.category · payees.source_id",
      "payments.source_id · payments.notes · payments.source_snapshot",
      "draft_origins.draft_id · draft_origins.job_id · draft_origins.input_hash"
