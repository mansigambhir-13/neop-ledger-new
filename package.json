{
  "name": "neops",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx apps/ledger/scripts/dev.ts",
    "seed": "tsx apps/ledger/scripts/seed.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "neos-publish": "tsx scripts/neos-publish.ts",
    "neos-install": "tsx scripts/neos-install.ts",
    "fleet:status": "tsx scripts/fleet/status.ts",
    "fleet:template-alignment": "node --import tsx scripts/fleet/template-alignment.ts",
    "fleet:template-gate": "node --import tsx scripts/fleet/run-template-gate.ts",
    "fleet:template-ownership": "node --import tsx scripts/fleet/template-ownership.ts"
  },
  "devDependencies": {
    "@neop/testkit": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@neop/ledger": "workspace:*",
    "@neop/marketing": "workspace:*",
    "@neop/wage": "workspace:*",
    "@neop/platform": "workspace:*",
    "@neop/template": "workspace:*",
    "@neop/pgkit": "workspace:*",
    "@neop/domain-values": "workspace:*",
    "@neop/pay": "workspace:*",
    "@neop/buy": "workspace:*",
    "@neop/renew": "workspace:*",
    "@neop/deal": "workspace:*",
    "@neop/quote": "workspace:*",
    "@neop/hire": "workspace:*",
    "@neop/desk": "workspace:*",
    "@neop/reach": "workspace:*",
    "@neop/roster": "workspace:*",
    "@neop/grant": "workspace:*",
    "@neop/shift": "workspace:*",
    "@neop/sync": "workspace:*",
    "@neop/post": "workspace:*",
    "@neop/sign": "workspace:*",
    "@neop/guard": "workspace:*",
    "@neop/vet": "workspace:*",
    "@neop/asset": "workspace:*",
    "@neop/clear": "workspace:*"
  }
}
