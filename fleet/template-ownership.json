      "fleet_paths": ["packages/neop-template/src/packages", "packages/platform/src/registry.ts"],
      "note": "Installed packages remain hash-bound installer output, never app-authored runtime code."
    },
    {
      "path": "src/**",
      "owner": "template",
      "state": "mapped",
      "strategy": "shared_runtime",
      "fleet_paths": ["packages/neop-template/src", "packages/platform/src"],
      "note": "Template-owned runtime behavior is centralized in shared packages."
    },
    {
      "path": "migrations/checksum.mjs",
      "owner": "template",
      "state": "mapped",
      "strategy": "shared_runtime",
      "fleet_paths": ["packages/pgkit/src/migrate.ts"],
      "note": "Shared migration code enforces immutable checksums and drift refusal."
    },
    {
      "path": "migrations/*_standard*.sql",
      "owner": "template",
      "render": true,
      "migration": true,
      "state": "mapped",
      "strategy": "forward_migration",
      "fleet_paths": ["packages/neop-template/migrations/t*.sql", "apps/{app}/migrations", "fleet/template-migrations.json", "scripts/fleet/testing/template-migration.ts"],
      "note": "The pinned 001-008 set is cross-walked to immutable forward fleet migrations and proved on fresh and populated databases."
    },
    {
      "path": "migrations/**",
      "owner": "app",
      "state": "mapped",
      "strategy": "app_owned",
      "fleet_paths": ["apps/{app}/migrations"],
      "note": "App migrations remain app-owned, immutable and forward-only."
    },
    {
      "path": "blocks/**",
      "owner": "app",
      "state": "mapped",
      "strategy": "app_owned",
      "fleet_paths": ["apps/{app}/blocks"],
      "note": "Blocks remain app-owned data-only UI declarations."
    },
    {
      "path": "tests/app.fixture.mjs",
      "owner": "app",
      "state": "mapped",
      "strategy": "compatibility_test",
      "fleet_paths": ["apps/{app}/tests/fixture.ts", "apps/{app}/tests/fixtures.ts"],
      "note": "App fixtures remain app-owned with TypeScript naming variants."
    },
    {
      "path": "tests/app/**",
      "owner": "app",
      "state": "mapped",
      "strategy": "compatibility_test",
      "fleet_paths": ["apps/{app}/tests"],
      "note": "Domain and workflow tests remain app-owned."
    },
    {
      "path": "tests/**",
      "owner": "template",
      "state": "mapped",
      "strategy": "compatibility_test",
      "fleet_paths": ["packages/neop-template/tests", "scripts/fleet/tests", "packages/testkit/src"],
      "note": "Every app has a zero-skip compatibility harness for each applicable pinned standard invariant."
    },
    {
      "path": "deploy/compose.app.yaml",
      "owner": "app",
      "seed": true,
      "state": "mapped",
      "strategy": "shared_deployment",
      "fleet_paths": ["fleet/catalog.json", "deploy/fleet/generated", "scripts/fleet/emit-manifests.ts"],
      "note": "The fleet emitter generates one deterministic app-specific Compose contract per declaration."
    },
    {
      "path": "deploy/**",
      "owner": "template",
      "render": true,
      "state": "mapped",
      "strategy": "shared_deployment",
      "fleet_paths": ["deploy/fleet", "scripts/fleet/packaging"],
      "note": "Shared backend, agent, and frontend images enforce the normalized topology and keep the database backend-only."
    },
    {
      "path": "scripts/**",
      "owner": "template",
      "state": "mapped",
      "strategy": "shared_runtime",
      "fleet_paths": ["scripts/fleet", "scripts/migrate.ts", "scripts/verify-install.ts", "scripts/neop-app-publish.ts", "scripts/neop-app-install.ts"],
      "note": "Shared commands cover manifest emission, migration, verification, model provider policy, signed publish, and atomic install."
    },
    {
      "path": "docs/NEOP-V3-ALIGNMENT.md",
      "owner": "app",
      "seed": true,
      "state": "mapped",
      "strategy": "app_owned",
      "fleet_paths": ["apps/{app}/NEOP-V3-ALIGNMENT.md"],
      "note": "Every catalogued app owns an alignment record."
    },
    {
      "path": "docs/BUILDING-A-NEOP.md",
      "owner": "template",
      "state": "mapped",
      "strategy": "documented_deviation",
      "fleet_paths": ["docs/BUILDING-A-NEOP.md", "docs/FLEET-V3-RUNTIME.md", "docs/TEMPLATE-ALIGNMENT-PLAN.md"],
      "note": "The fleet construction guide documents app ownership, generation, verification, credentials, and release."
    },
    {
      "path": "docs/CHATGPT-PLAN-PROVIDER.md",
      "owner": "template",
      "state": "mapped",
      "strategy": "documented_deviation",
      "fleet_paths": ["packages/platform/src/llm", "apps/ledger/scripts/llm-proxy.ts", "fleet/template-provider.json", "docs/adr/0033-pinned-template-model-provider-contract.md"],
      "note": "The reviewed provider decision keeps the stronger short-lived keyless proxy, supports OpenRouter, and fails closed."
    },
    {
      "path": "docs/NEOP-WHOLE-PICTURE-v3.md",
      "owner": "template",
      "state": "mapped",
      "strategy": "documented_deviation",
      "fleet_paths": ["fleet/requirements.json"],
      "note": "The pinned governing specification is represented by its reviewed requirement inventory and digest."
    },
    {
      "path": ".env.example",
      "owner": "template",
      "render": true,
      "state": "mapped",
      "strategy": "shared_deployment",
      "fleet_paths": ["deploy/fleet/runtime.env.example", "scripts/fleet/runtime/config.ts", "deploy/fleet/generated"],
      "note": "The shared non-secret environment example and generated Compose files preserve strict per-process credential placement."
    },
    {
      "path": ".gitignore",
      "owner": "template",
      "state": "mapped",
      "strategy": "repository_policy",
      "fleet_paths": [".gitignore"],
      "note": "The monorepo owns one shared ignore policy."
    },
    {
      "path": ".dockerignore",
      "owner": "template",
      "state": "mapped",
      "strategy": "repository_policy",
      "fleet_paths": [".dockerignore"],
      "note": "The monorepo owns one shared build-context policy."
    },
    {
      "path": "manifest.json",
      "owner": "generated",
      "state": "mapped",
      "strategy": "generated_contract",
      "fleet_paths": ["apps/{app}/app.declaration.json", "apps/{app}/manifest.json", "apps/{app}/manifest.template.json", "packages/neop-template/src/declaration.ts"],
      "note": "Both stored manifests are deterministic generated artifacts of the typed app declaration."
    },
    {
      "path": "template.json",
      "owner": "template",
      "state": "mapped",
      "strategy": "repository_policy",
      "fleet_paths": ["reference/upstream/neos-neop-template/template.json", "fleet/template-alignment.json", "fleet/template-ownership.json"],
      "note": "The monorepo preserves the exact pinned template definition and validated ownership crosswalk."
    },
    {
      "path": "frontend/server.mjs",
      "owner": "template",
      "render": true,
      "state": "mapped",
      "strategy": "shared_frontend",
      "fleet_paths": ["packages/neop-frontend/src/index.ts"],
      "note": "The shared standalone frontend serves the no-login surface and authenticated backend proxy."
    },
    {
      "path": "frontend/next.config.mjs",
      "owner": "template",
      "state": "mapped",
      "strategy": "shared_frontend",
      "fleet_paths": ["packages/neop-frontend/src/index.ts", "scripts/fleet/runtime/frontend.ts"],
      "note": "The server-rendered fleet adapter applies the same base-path contract without a Next.js build dependency."
    },
    {
      "path": "frontend/lib/**",
      "owner": "template",
      "state": "mapped",
      "strategy": "shared_frontend",
      "fleet_paths": ["packages/neop-frontend/src/index.ts", "packages/testkit/src/template-frontend.ts"],
      "note": "Shared API, provenance, empty-state, and failure helpers are implemented and behavior-tested."
    },
    {
      "path": "frontend/**",
      "owner": "app",
      "state": "mapped",
      "strategy": "app_owned",
      "fleet_paths": ["apps/{app}/blocks", "apps/{app}/manifest.template.json", "apps/{app}/scripts/frontend.ts"],
      "note": "Each app owns its data-only screen declarations and generated frontend entry while sharing the hardened shell."
    },
    {
      "path": "dev/apps.fixtures.json",
      "owner": "app",
      "seed": true,
      "state": "mapped",
      "strategy": "development_fixture",
      "fleet_paths": ["fleet/dev-apps.fixtures.json", "packages/testkit/src", "apps/{app}/tests/fixture.ts", "apps/{app}/tests/fixtures.ts"],
      "note": "The fleet fixture contract names every app declaration, generated output, Compose contract, and local fixture."
    },
    {
      "path": "**",
      "owner": "app",
      "state": "mapped",
      "strategy": "app_owned",
      "fleet_paths": ["apps/{app}"],
      "note": "Unmatched app-specific files stay app-owned."
    }
  ]
}
