# Admin connection used only by migration runners and test harness (never by an app at runtime).
NEOS_ADMIN_URL=postgres://neos_admin:neos_admin@localhost:5433/neos
# Model access for the assistant goes through the LLM proxy with a per-app virtual key.
NEOP_LLM_BASE_URL=https://api.anthropic.com
NEOP_LLM_API=anthropic-messages
NEOP_LLM_MODEL=claude-sonnet-5
NEOP_LLM_VIRTUAL_KEY=
