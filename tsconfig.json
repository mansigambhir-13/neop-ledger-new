{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "apps/*/src",
    "apps/*/tests",
    "apps/*/scripts",
    "vitest.config.ts",
    "apps/*/load",
    "vitest.load.config.ts",
    "scripts"
  ]
}
